{
  "schemaVersion": "1.2",
  "protocol": "wordrava",
  "protocolVersion": "1.0",
  "minimumConnectorProtocol": "1.0",
  "centerVersion": "0.2.0",
  "pairing": {
    "issuer": "center",
    "claimant": "wordpress-connector",
    "ttlSeconds": 600,
    "singleUse": true,
    "claimEndpoint": "POST /api/v1/connectors/claim",
    "requestProtocolField": "protocolVersion",
    "connectorSecret": "per-site 256-bit random secret; SHA-256 stored at Center",
    "existingSiteUpgrade": "existingSiteId accepted for same owner and URL after new pairing code",
    "proof": "one-time user pairing code plus outbound connector key; no independent DNS ownership attestation"
  },
  "capabilities": {
    "endpoint": "GET /api/v1/capabilities",
    "oauthFeatureFlag": "WORDRAVA_OAUTH_ENABLED",
    "operationsFeatureFlag": "WORDRAVA_OPERATIONS_ENABLED",
    "enabledByDefault": false,
    "publicOAuthAvailableWhenEnabled": true,
    "remoteWriteAvailableWhenEnabled": "draft-only and WordPress-admin-opt-in",
    "siteBlocking": true,
    "userBlocking": true,
    "planDrivenQuota": true,
    "readOnlyMcpTools": [
      "wordrava_list_sites",
      "wordrava_my_account",
      "wordrava_site_usage",
      "wordrava_capabilities",
      "wordrava_site_overview",
      "wordrava_list_plugins",
      "wordrava_list_menus",
      "wordrava_list_content",
      "wordrava_get_content",
      "wordrava_job_status"
    ],
    "writeMcpTools": [
      "wordrava_create_draft",
      "wordrava_update_draft"
    ]
  },
  "oauth": {
    "authorizationServerMetadata": "GET /.well-known/oauth-authorization-server",
    "protectedResourceMetadata": "GET /.well-known/oauth-protected-resource",
    "authorize": "GET+POST /oauth/authorize",
    "token": "POST /oauth/token",
    "revoke": "POST /oauth/revoke",
    "tokenValidation": "GET /api/v1/oauth/session",
    "flow": "authorization_code+PKCE S256; public registered client; refresh rotation",
    "scopes": [
      "sites:read",
      "content:read",
      "content:write"
    ],
    "publicByDefault": false
  },
  "operation": {
    "status": "implemented-feature-flagged-beta",
    "endpoint": "POST /api/v1/sites/{siteId}/jobs",
    "resultEndpoint": "GET /api/v1/sites/{siteId}/jobs/{jobId}",
    "connectorPoll": "POST /api/v1/connector-jobs/poll",
    "connectorComplete": "POST /api/v1/connector-jobs/complete",
    "types": {
      "read": [
        "site_overview",
        "list_plugins",
        "list_menus",
        "list_content",
        "get_content"
      ],
      "write": [
        "create_draft",
        "update_draft"
      ]
    },
    "idempotencyHeader": "Idempotency-Key",
    "authorization": "center-per-site ownership and OAuth per-operation scope",
    "quota": "serializable reservation of pending and successful jobs",
    "chargeOn": "successful-operation",
    "blockedSite": "deny",
    "blockedUser": "deny",
    "writes": "draft-only; requires MCP confirmation flag and WordPress admin opt-in",
    "limitations": [
      "No verified end-to-end WordPress staging acceptance yet",
      "No independent human-approval credential enforced by Center",
      "No publish/delete or page-builder structured edits",
      "No atomic rollback of content edits"
    ]
  },
  "usage": {
    "endpoint": "GET /api/v1/usage/{siteId}",
    "timezone": "UTC",
    "reset": "00:00",
    "freeDailyLimitDefault": 200,
    "limitSource": "center-plan",
    "blockedSiteResponse": 404,
    "purchasedCredits": "not implemented"
  },
  "access": {
    "userBlock": "deny-login-and-existing-token-at-center",
    "siteBlock": "deny-usage-and-future-operations-at-center",
    "siteListingIncludesBlocked": true
  },
  "compatibility": {
    "additiveChanges": "wire protocol 1.0 retained",
    "breakingChanges": "new-protocol-version",
    "securityFixes": "plugin-update-may-be-required"
  },
  "quickPairing": {
    "mode": "wordpress-first",
    "version": 1,
    "featureFlag": "WORDRAVA_QUICK_PAIRING_ENABLED",
    "passwordlessOAuthFlag": "WORDRAVA_PASSWORDLESS_OAUTH_ENABLED",
    "generateCode": "WordPress admin-only: 256-bit random hex, 600 seconds",
    "start": "POST /api/v1/pairing/start (OAuth authenticated)",
    "confirm": "POST /api/v1/pairing/confirm (WP outbound, exact code+request ID+URL, one-use)",
    "status": "GET /api/v1/pairing/status/{requestId} (OAuth authenticated)",
    "identity": "Provisional OAuth principal activates only after WordPress administrator confirmation",
    "accountPlan": "Free default; Admin account plan overrides default; explicit per-site plan overrides account plan",
    "limits": "No automatic takeover of an already paired site; recovery requires a separately verified account-linking workflow",
    "writes": "Disabled until explicit administrator and user approvals"
  }
}
