{
  "schemaVersion": "1.1",
  "protocol": "wordrava",
  "protocolVersion": "1.0",
  "minimumConnectorProtocol": "1.0",
  "centerVersion": "0.1.1",
  "pairing": {
    "issuer": "center",
    "claimant": "wordpress-connector",
    "ttlSeconds": 600,
    "singleUse": true,
    "claimEndpoint": "POST /api/v1/connectors/claim",
    "requestProtocolField": "protocolVersion",
    "proof": "planned-server-side-site-identity-verification"
  },
  "capabilities": {
    "endpoint": "GET /api/v1/capabilities",
    "remoteWriteEnabled": false,
    "publicOAuthEnabled": false,
    "siteBlocking": true,
    "userBlocking": true,
    "planDrivenQuota": true,
    "readOnlyMcpTools": [
      "wordrava_list_sites",
      "wordrava_my_account",
      "wordrava_site_usage",
      "wordrava_capabilities"
    ]
  },
  "operation": {
    "status": "planned-not-exposed",
    "endpoint": "POST /api/v1/sites/{siteId}/operations",
    "idempotencyHeader": "Idempotency-Key",
    "authorization": "center-per-operation",
    "quota": "center-atomic-reservation-planned",
    "chargeOn": "successful-operation",
    "blockedSite": "deny",
    "blockedUser": "deny"
  },
  "usage": {
    "endpoint": "GET /api/v1/usage/{siteId}",
    "timezone": "UTC",
    "reset": "00:00",
    "freeDailyLimitDefault": 200,
    "limitSource": "center-plan",
    "blockedSiteResponse": 404,
    "purchasedCredits": "separate-ledger-planned"
  },
  "access": {
    "userBlock": "deny-login-and-existing-token-at-center",
    "siteBlock": "deny-usage-and-future-operations-at-center",
    "siteListingIncludesBlocked": true
  },
  "compatibility": {
    "additiveChanges": "no-plugin-update",
    "breakingChanges": "new-protocol-version",
    "securityFixes": "plugin-update-may-be-required"
  }
}
